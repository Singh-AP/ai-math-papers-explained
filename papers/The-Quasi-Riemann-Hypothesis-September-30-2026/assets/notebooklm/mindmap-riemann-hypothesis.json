          "name": "Non-trivial Zeros: Lie on the Critical Line Re(s) = 1/2"
        },
        {
          "name": "Critical Strip: 0 < Re(s) < 1"
        },
        {
          "name": "Status: Hilbert's 8th Problem & Millennium Prize Problem ($1M)"
        }
      ]
    },
    {
      "name": "Riemann Zeta Function ζ(s)",
      "children": [
        {
          "name": "Sum Definition: ∑ (1/n^s) for Re(s) > 1"
        },
        {
          "name": "Euler Product: ∏ (1 - p^-s)^-1 over all primes p"
        },
        {
          "name": "Analytic Continuation: Meromorphic function over C (pole at s=1)"
        },
        {
          "name": "Dirichlet Eta Function: Extends domain to Re(s) > 0"
        },
        {
          "name": "Functional Equation: Relates ζ(s) to ζ(1-s)"
        }
      ]
