          "name": "Uniform Commutator Estimate (Theorem 1.2)",
          "children": [
            {
              "name": "Absolute constant C controls matrix amplifications"
            },
            {
              "name": "Bound: ||[Y(h), X]|| ≤ C * gP(Y) * ||X||"
            },
            {
              "name": "Uniform in matrix size h, algebra P, and Hilbert space K"
            }
          ]
        },
