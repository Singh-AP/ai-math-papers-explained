            },
            {
              "name": "Bounded algebra homomorphism π: A → B(H) is similar to a *-homomorphism"
            },
            {
              "name": "Exists bounded invertible S such that ρ(a) = Sπ(a)S⁻¹ is a *-homomorphism"
            },
            {
              "name": "No separability, nuclearity, or normality conditions required"
            }
          ]
        },
